<IfModule mod_headers.set>
    # ----------------------------------------------------------------------
    # Cache Control
    # ----------------------------------------------------------------------
    
    # 1. Never cache index.html to ensure users always get the latest app version
    <FilesMatch "^(index\.html)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>

    # 2. Cache hashed static assets (js, css, media) aggressively for 1 year
    <FilesMatch "\.(css|js|webp|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # 3. Cache other files (json, xml, etc) for a short period (1 day)
    <FilesMatch "\.(json|xml|txt)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>
